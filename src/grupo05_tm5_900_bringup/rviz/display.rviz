        Y: -0.010892870835959911
        Z: 0.5643020272254944
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.45979753136634827
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.5818679332733154
    Saved: ~
